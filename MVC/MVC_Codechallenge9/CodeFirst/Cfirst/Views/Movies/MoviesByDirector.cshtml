
@model IEnumerable<Cfirst.Models.Movie>
@using System.Collections.Generic

@{
    ViewBag.Title = "Movies by Director";
}

<h2>Movies by @ViewBag.DirectorName]</h2>


<table class="table">
    <tr>
        <th>Movie Name</th>
        <th>Director</th>
        <th>Date of Release</th>
    </tr>

    @foreach (var movie in Model)
    {
        <tr>
            <td>@movie.Moviename</td>
            <td>@movie.DirectorName</td>
            <td>@movie.DateofRelease.ToShortDateString()</td>
        </tr>
    }
</table>

